# Global
*.html
dist/
.nuxt
*.min.*

# Vendored third-party sources — Smart HTML Elements, shipped as-is under
# public/source. 3 881 of the 3 930 errors `yarn code:lint` reported came from
# these two files, which made both `code:lint` and the pre-commit hook
# unusable. They are not ours to fix. (Introduced by 57621654.)
public/source/components/smart.ui.tree.js
public/source/modules/smart.tree.js

# Per packages overrides
packages/editor/*
public/lang/*
packages/documentation/.vuepress/dist/
packages/documentation/api/

!packages/editor/src/js/vue/*
# Vue 3 SFC, compiled at build time by scripts/compile-block-builder-components.js.
# The project's eslint is configured for Vue 2 and cannot parse <script setup>.
packages/shared/block-builder/components/*.vue

# And its output. `eslint --fix` would rewrite the quoting of a generated file
# and the golden test would then fail on something nobody edited.
packages/shared/block-builder/components/*.compiled.js
